# Nexus Prime does not require an API key, account password, or remote server.
#
# This file is a safe inventory of optional development/runtime overrides.
# The Rust application does not automatically load `.env`; export a variable
# in your shell before starting the app when you need an override.
#
# Example (PowerShell):
#   $env:RUST_LOG = "info"
#   npm run tauri:dev

# Tauri/Vite development host. Leave unset to bind locally.
# TAURI_DEV_HOST=127.0.0.1

# Rust log filter used during development.
# RUST_LOG=info

# Advanced local-only overrides. Paths must point to files on your machine.
# REMOTE_BRIDGE_XIAOMI_HID_TAP_PORT=30684
# REMOTE_BRIDGE_XIAOMI_GADGET_ARCHIVE=C:\path\to\frida-gadget.dll.xz
# REMOTE_BRIDGE_XIAOMI_VB_CABLE_ZIP=C:\path\to\VBCABLE_Driver_Pack45.zip
# REMOTE_BRIDGE_WINUHID_DLL=C:\path\to\WinUHid.dll
# REMOTE_BRIDGE_XIAOMI_RUNTIME_ID=RemoteBridgeHub
# REMOTE_BRIDGE_XIAOMI_FORCE_GATT_HID=0
